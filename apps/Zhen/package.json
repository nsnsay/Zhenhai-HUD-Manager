{
  "name": "@zhenhai/zhen",
  "version": "2.0.4",
  "private": true,
  "description": "An Electron application with Vue and TypeScript",
  "homepage": "https://electron-vite.org",
  "author": "example.com",
  "main": "./out/main/index.js",
  "scripts": {
    "format": "prettier --write .",
    "lint": "eslint --cache .",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json --composite false",
    "typecheck:web": "vue-tsc --noEmit -p tsconfig.web.json --composite false",
    "typecheck": "bun run typecheck:node && bun run typecheck:web",
    "start": "electron-vite preview",
    "dev": "electron-vite dev --watch",
    "build": "bun run typecheck && electron-vite build",
    "postinstall": "electron-builder install-app-deps",
    "version:patch": "node scripts/bump-version.js",
    "build:unpack": "bun run build && electron-builder --dir",
    "build:win": "bun run version:patch && bun run build && electron-builder --win",
    "build:mac": "bun run build && electron-builder --mac",
    "build:linux": "bun run build && electron-builder --linux"
  },
  "dependencies": {
    "@ctechhindi/vue3-json-viewer": "^1.0.5",
    "@electron-toolkit/preload": "^3.0.2",
    "@electron-toolkit/utils": "^4.0.0",
    "@nuxt/ui": "^4.11.0",
    "@types/express": "^5.0.6",
    "@vueuse/core": "^14.4.0",
    "@zhenhai/csgogsi": "workspace:*",
    "bufferutil": "^4.1.0",
    "electron-log": "^5.4.4",
    "electron-updater": "^6.3.9",
    "express": "^5.2.1",
    "lowdb": "^7.0.1",
    "steam-game-path": "^3.0.2",
    "typescript": "^6.0.3",
    "utf-8-validate": "^6.0.6",
    "vue-tsc": "^3.3.7"
  },
  "devDependencies": {
    "@electron-toolkit/eslint-config-prettier": "3.0.0",
    "@electron-toolkit/eslint-config-ts": "^3.1.0",
    "@electron-toolkit/tsconfig": "^2.0.0",
    "@types/node": "^22.19.1",
    "electron": "latest",
    "electron-builder": "latest",
    "electron-process-manager": "^1.2.0",
    "electron-vite": "latest",
    "eslint": "^9.39.1",
    "eslint-plugin-vue": "^10.6.2",
    "vite": "^7.2.6",
    "vue-eslint-parser": "^10.2.0"
  }
}
