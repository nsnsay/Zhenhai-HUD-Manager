{
  "name": "@zhenhai/csgogsi",
  "version": "6.0.1",
  "private": true,
  "description": "ZhenHai adapter on top of upstream csgogsi: re-exports, business types and the Vue GSI store.",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./types": {
      "types": "./src/types.ts",
      "default": "./src/types.ts"
    },
    "./gsi-vue": {
      "types": "./utils/gsi.ts",
      "default": "./utils/gsi.ts"
    },
    "./package.json": "./package.json"
  },
  "types": "./src/index.ts",
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "csgogsi": "6.0.1"
  },
  "peerDependencies": {
    "pinia": "^4.0.2",
    "socket.io-client": "^4.8.3",
    "vue": "^3.5.42"
  },
  "devDependencies": {
    "pinia": "^4.0.2",
    "socket.io-client": "^4.8.3",
    "typescript": "~6.0.0",
    "vue": "^3.5.42"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}