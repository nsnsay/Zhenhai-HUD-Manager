{
  "name": "Zhen-Hai",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "turbo run dev",
    "dev:zhen": "turbo run dev --filter=@repo/zhen",
    "dev:hai": "turbo run dev --filter=@repo/hai",
    "build": "bun run --cwd apps/Hai build && bun run --cwd apps/Zhen build:win",
    "typecheck": "turbo run typecheck",
    "lint": "turbo run lint",
    "format": "turbo run format",
    "clean": "turbo run clean"
  },
  "dependencies": {
    "@fontsource-variable/sora": "^5.3.0",
    "@zhenhai/zhen": "workspace:*",
    "flag-icons": "^7.5.0",
    "pinia": "^4.0.2",
    "socket.io": "^4.8.3",
    "socket.io-client": "^4.8.3",
    "vue-router": "^5.2.0",
    "ws": "^8.21.3"
  },
  "devDependencies": {
    "@tailwindcss/vite": "latest",
    "@vitejs/plugin-vue": "^6.0.8",
    "prettier": "^3.7.4",
    "sass-embedded": "latest",
    "tailwindcss": "latest",
    "tsc": "^2.0.4",
    "turbo": "^2.10.12",
    "typescript": "~6.0.0",
    "vite-plugin-vue-devtools": "latest",
    "vue": "^3.5.42",
    "vue-tsc": "^3.3.7"
  },
  "overrides": {
    "@vue/compat": "^3.5.42",
    "@vue/compiler-core": "^3.5.42",
    "@vue/compiler-dom": "^3.5.42",
    "@vue/compiler-sfc": "^3.5.42",
    "@vue/compiler-ssr": "^3.5.42",
    "@vue/reactivity": "^3.5.42",
    "@vue/runtime-core": "^3.5.42",
    "@vue/runtime-dom": "^3.5.42",
    "@vue/server-renderer": "^3.5.42",
    "@vue/shared": "^3.5.42",
    "typescript": "~6.0.0",
    "vue": "^3.5.42"
  },
  "packageManager": "bun@1.3.14",
  "trustedDependencies": [
    "electron",
    "esbuild",
    "electron-builder",
    "node-gyp",
    "sass-embedded"
  ]
}
